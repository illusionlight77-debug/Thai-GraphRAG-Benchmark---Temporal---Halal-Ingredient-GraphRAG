# ==================================================================
# Thai GraphRAG + Benchmark — environment
# Copy to .env and fill in. NEVER commit .env.
# ==================================================================

# ── Knowledge graph (Neo4j) ──────────────────────────────────────
# Inside docker compose the app overrides the host to bolt://neo4j:7687
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=thaigraphrag         # docker-compose reads this for NEO4J_AUTH too

# ── Vector store (Qdrant) — vanilla-RAG baseline ─────────────────
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# ── Embeddings (local bge-m3 via TEI, HTTP) ──────────────────────
EMBEDDING_URL=http://localhost:8080     # TEI endpoint
EMBEDDING_DIM=1024
EMBED_BATCH=64                          # must be <= TEI --max-client-batch-size

# ── LLM grounding + judge (OpenAI-compatible; Groq by default) ───
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=                            # <<< set your key
LLM_MODEL=llama-3.1-8b-instant
JUDGE_MODEL=llama-3.1-8b-instant        # LLM-as-judge for faithfulness

# ── Retrieval / GraphRAG tuning ──────────────────────────────────
TOP_K=5                 # vanilla: top-k chunks; graphrag: seed nodes
GRAPH_HOPS=2            # subgraph expansion depth for GraphRAG
SIMILARITY_THRESHOLD=0.5
MAX_TRIPLES=60          # cap on subgraph facts handed to the LLM (keeps the
                        # comparison about structure, not prompt budget)

# ── Data source ──────────────────────────────────────────────────
# Folder holding restuarant.csv, hotel.csv, …, product_processed.csv and
# thailand_provinces.json. Docker bind-mounts this read-only at /app/data.
DATA_DIR=./data
PROVINCE_GEOJSON=thailand_provinces.json

# ── KG build ─────────────────────────────────────────────────────
# product_processed.csv has 222k rows; embedding all of them on CPU takes hours.
# The build takes a deterministic category-stratified sample of this size and puts
# the SAME sample into Neo4j and Qdrant. Set 0 to ingest every row.
MAX_PRODUCT_ROWS=20000

# ── App / first-boot bootstrap (docker compose) ──────────────────
SKIP_BOOTSTRAP=0        # 1 = serve immediately, skip everything below
SKIP_KG_BUILD=0         # 1 = keep the graph as-is
SKIP_BENCHMARK=0        # 1 = do not run the benchmark on boot
BOOTSTRAP_JUDGE=0       # 1 = include LLM-as-judge in the boot benchmark
BOOTSTRAP_LIMIT=0       # >0 = build only the first N products (fast smoke boot)
